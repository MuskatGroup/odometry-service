FROM ros:humble-ros-base-jammy
SHELL ["/bin/bash", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pytest python3-yaml python3-websockets ros-humble-nav-msgs ros-humble-diagnostic-msgs \
    ros-humble-rosbag2 ros-humble-rosbag2-storage-default-plugins \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/ python/
COPY configs/ configs/
COPY dataset/Pathgraph/ dataset/Pathgraph/
COPY ros2_ws/ ros2_ws/
RUN source /opt/ros/humble/setup.bash && cd ros2_ws && colcon build
COPY contracts/ contracts/
COPY tests/ tests/
ENV PYTHONPATH=/workspace/python/odometry_lab/src
COPY infra/ros-entrypoint.sh /ros-entrypoint.sh
RUN chmod +x /ros-entrypoint.sh
ENTRYPOINT ["/ros-entrypoint.sh"]
CMD ["ros2", "launch", "odometry_node", "reserve.launch.py"]
