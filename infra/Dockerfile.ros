FROM ros:humble-ros-base-jammy
SHELL ["/bin/bash", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip ros-humble-nav-msgs ros-humble-diagnostic-msgs \
    ros-humble-rosbag2 ros-humble-rosbag2-storage-default-plugins \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/ python/
RUN pip3 install --no-cache-dir ./python/odometry_core ./python/odometry_io ./python/odometry_lab pytest==8.4.2
COPY ros2_ws/ ros2_ws/
RUN source /opt/ros/humble/setup.bash && cd ros2_ws && colcon build
COPY contracts/ contracts/
COPY configs/ configs/
COPY dataset/Pathgraph/ dataset/Pathgraph/
COPY tests/ tests/
COPY infra/ros-entrypoint.sh /ros-entrypoint.sh
RUN chmod +x /ros-entrypoint.sh
ENTRYPOINT ["/ros-entrypoint.sh"]
CMD ["ros2", "run", "odometry_node", "estimator"]
