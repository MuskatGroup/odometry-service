FROM ros:humble-ros-base-jammy
SHELL ["/bin/bash", "-c"]
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pytest python3-yaml ros-humble-nav-msgs ros-humble-diagnostic-msgs \
    ros-humble-rosbag2 ros-humble-rosbag2-storage-default-plugins \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY python/odometry_core/ python/odometry_core/
COPY python/odometry_geometry/ python/odometry_geometry/
COPY python/odometry_io/ python/odometry_io/
COPY configs/ configs/
COPY dataset/Pathgraph/ dataset/Pathgraph/
COPY ros2_ws/ ros2_ws/
RUN source /opt/ros/humble/setup.bash && cd ros2_ws && colcon build
COPY tests/test_adaptive.py tests/test_fixed_lag.py tests/test_geometry.py tests/test_model_config.py tests/test_organizer_contract.py tests/
COPY tests/integration/ tests/integration/
COPY tools/validate_rosbag.py tools/validate_rosbag.py
COPY infra/ros-entrypoint.sh /ros-entrypoint.sh
RUN chmod +x /ros-entrypoint.sh
ENTRYPOINT ["/ros-entrypoint.sh"]
CMD ["ros2", "launch", "odometry_node", "reserve.launch.py"]
