{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estimate frame v0.2",
  "type": "object",
  "required": [
    "run_id",
    "seq",
    "stamp_ns",
    "has_estimate",
    "s_m",
    "v_mps",
    "valid",
    "mode",
    "uncertainty_available",
    "sigma_s_m",
    "sigma_v_mps"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stamp_ns": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "has_estimate": {
      "type": "boolean"
    },
    "s_m": {
      "type": [
        "number",
        "null"
      ]
    },
    "v_mps": {
      "type": [
        "number",
        "null"
      ]
    },
    "valid": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "INITIALIZING",
        "FUSED",
        "DEGRADED",
        "MODEL_ONLY",
        "INVALID"
      ]
    },
    "uncertainty_available": {
      "type": "boolean"
    },
    "sigma_s_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "sigma_v_mps": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "wheel_speeds_mps": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "uncertainty_available": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "sigma_s_m": {
            "type": "number"
          },
          "sigma_v_mps": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "has_estimate": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "s_m": {
            "type": "number"
          },
          "v_mps": {
            "type": "number"
          }
        }
      }
    }
  ]
}
